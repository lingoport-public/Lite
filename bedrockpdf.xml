<?xml version="1.0" encoding="utf-8" ?>
<!-- see  http://wiki.lingoport.com/index.php5?title=Globalyzer_Lite#The_.globalyzerrc_File -->
<gzproject>
  <login>
    <use-ai-analyze>true</use-ai-analyze>
    <ai-model>anthropic.claude-haiku-4-5</ai-model>
    <ai-account-token>$GZTOKEN</ai-account-token>
    <base-url>https://bedrock-mantle.us-east-1.api.aws/anthropic/v1/messages</base-url>
    <api-format>claude</api-format>
  </login>
  <extensions>js,java</extensions>
  <exclusions>**/.settings/**</exclusions>
  <project-path>C:\Users\Olivier\git\Lite</project-path>
  <report-path>globalyzer-lite-reports</report-path>
  <scans>

    <scan>
      <checks>
        <embedded-strings>true</embedded-strings>
        <locale-sensitive-methods>true</locale-sensitive-methods>
        <general-patterns>true</general-patterns>
        <static-file-references>true</static-file-references>
      </checks>
      <scan-items>
        <item>src/com/lingoport/demo/java/utils</item>
        <item>src/com/lingoport/demo/java/ExampleMain.java</item>
      </scan-items>

    </scan>
  </scans>
</gzproject>
